{
    "autoSessionName": {
        "model": "openai-codex/gpt-5.6-luna",
        "renameOnCompaction": "on"
    },
    "cockpitPanel": {
        "gitPollInterval": 5000,
        "prPollInterval": 30000,
        "usagePollInterval": 300000,
        "workspaceProfiles": {
            "nameOverrides": {
                "/.pi/agent": "Pi Coding Agent",
                "Comms/comms-backend": "[Backend] Comms",
                "Comms/comms-web": "[Web] Comms",
                "Others/doist-os": "DoistOS",
                "Todoist/Todoist": "[Backend] Todoist",
                "Todoist/todoist-web": "[Web] Todoist",
                "Twist/twist-web": "[Web] Twist"
            },
            "colors": {
                "comms": "#766bbd",
                "todoist": "#e06155",
                "twist": "#22a5bf"
            }
        }
    },
    "handoff": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low"
    },
    "oracle": {
        "models": ["openai-codex/gpt-5.6-sol", "anthropic/claude-opus-5"],
        "maxThinking": "auto"
    },
    "sessionDefaults": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "xhigh"
    },
    "sessionSnap": {
        "deleteMaxDurationMinutes": 5,
        "deleteMaxUserMessages": 3,
        "archiveAfterDays": 180,
        "keepFavorites": true
    }
}
